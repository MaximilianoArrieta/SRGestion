@page "/login"
@layout LoginLayout
@inject SrAuthStateProvider Auth
@inject NavigationManager Nav

<PageTitle>Iniciar sesión · SR</PageTitle>

<div class="login">
    <div class="caja">
        <div class="cabeza">
            <img src="img/logo.png" alt="SR Distribución de Máquinas Recreativas" />
            <div class="franjas"></div>
        </div>
        <div class="cuerpo">
            <h1>Inicio de sesión</h1>
            <Alerta @bind-Mensaje="error" />

            <EditForm Model="modelo" OnValidSubmit="Ingresar">
                <DataAnnotationsValidator />
                <div class="campo">
                    <label for="usuario">Usuario</label>
                    <InputText id="usuario" @bind-Value="modelo.Usuario" autocomplete="username" />
                    <ValidationMessage For="() => modelo.Usuario" />
                </div>
                <div class="campo" style="margin-top:1rem">
                    <label for="clave">Contraseña</label>
                    <InputText id="clave" type="password" @bind-Value="modelo.Password" autocomplete="current-password" />
                    <ValidationMessage For="() => modelo.Password" />
                </div>
                <button class="btn" type="submit" disabled="@enviando">@(enviando ? "Ingresando..." : "Ingresar")</button>
            </EditForm>

            <div class="pie"><BotonTema /></div>
        </div>
    </div>
</div>

@code {
    readonly LoginRequest modelo = new();
    string? error;
    bool enviando;

    async Task Ingresar()
    {
        enviando = true;
        error = null;
        try
        {
            await Auth.IniciarSesionAsync(modelo);
            Nav.NavigateTo("", replace: true);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        finally
        {
            enviando = false;
        }
    }
}
