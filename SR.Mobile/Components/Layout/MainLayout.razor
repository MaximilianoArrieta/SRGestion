@inherits LayoutComponentBase
@inject SrAuthStateProvider Auth
@inject NavigationManager Nav

<div class="app">
    <header class="barra-sup">
        <img class="img-oscuro" src="img/logo-cabecera.png" alt="SR" />
        <img class="img-claro" src="img/logo-cabecera-claro.png" alt="SR" />
        <BotonTema />
    </header>

    <main class="contenido">
        @Body
    </main>

    <AuthorizeView>
        <nav class="barra-inf" aria-label="Menú">
            @if (context.User.EsAdmin())
            {
                <NavLink href="admin" Match="NavLinkMatch.All">
                    <svg viewBox="0 0 24 24"><path d="M3 11l9-8 9 8M5 10v10h14V10" /></svg>Inicio
                </NavLink>
                <NavLink href="admin/clientes">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 4-6 8-6s8 2 8 6" /></svg>Clientes
                </NavLink>
                <NavLink href="admin/maquinas">
                    <svg viewBox="0 0 24 24"><rect x="5" y="2" width="14" height="20" rx="2" /><rect x="8" y="5" width="8" height="6" /><circle cx="9" cy="16" r="1.5" /><circle cx="15" cy="16" r="1.5" /></svg>Máquinas
                </NavLink>
                <NavLink href="admin/operaciones">
                    <svg viewBox="0 0 24 24"><path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0" /><circle cx="16" cy="6" r="2" /><circle cx="10" cy="12" r="2" /><circle cx="18" cy="18" r="2" /></svg>Operaciones
                </NavLink>
                <NavLink href="admin/reportes">
                    <svg viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M9 8h6M9 12h6M9 16h4" /></svg>Reportes
                </NavLink>
            }
            else
            {
                <NavLink href="cliente" Match="NavLinkMatch.All">
                    <svg viewBox="0 0 24 24"><rect x="5" y="2" width="14" height="20" rx="2" /><rect x="8" y="5" width="8" height="6" /><circle cx="9" cy="16" r="1.5" /><circle cx="15" cy="16" r="1.5" /></svg>Máquinas
                </NavLink>
                <NavLink href="cliente/cobranzas">
                    <svg viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M9 8h6M9 12h6M9 16h4" /></svg>Cobranzas
                </NavLink>
                <NavLink href="cliente/solicitudes">
                    <svg viewBox="0 0 24 24"><path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12" /><circle cx="16" cy="6" r="2" /><circle cx="10" cy="12" r="2" /></svg>Solicitudes
                </NavLink>
            }
            <button type="button" @onclick="Salir">
                <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" /></svg>Salir
            </button>
        </nav>
    </AuthorizeView>
</div>

@code {
    async Task Salir()
    {
        await Auth.CerrarSesionAsync();
        Nav.NavigateTo("login", replace: true);
    }
}
