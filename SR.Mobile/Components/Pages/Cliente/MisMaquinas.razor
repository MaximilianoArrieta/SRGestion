@page "/cliente"
@attribute [Authorize(Roles = Roles.Cliente)]
@inject SrApi Api

<div class="titulo">
    <h1>Máquinas asignadas</h1>
    <p>Las máquinas de SR en tu comercio.</p>
</div>

<Alerta @bind-Mensaje="error" />
<Alerta @bind-Mensaje="ok" Ok="true" />

@if (maquinas is null)
{
    <Cargando />
}
else if (maquinas.Count == 0)
{
    <div class="vacio">Todavía no tenés máquinas instaladas.</div>
}
else
{
    <div class="lista">
        @foreach (var m in maquinas)
        {
            <div class="item">
                <div class="cab">
                    <strong>@m.NumeroIdentificacion</strong>
                    <span class="chip cian">@m.Tipo</span>
                </div>
                <div class="linea">@m.Descripcion</div>
                @if (m.FechaRetiroProgramada is not null)
                {
                    <div class="linea">Retiro previsto: @Textos.Fecha(m.FechaRetiroProgramada)</div>
                }
                <div class="fila-btn">
                    <button class="btn chico peligro" type="button" @onclick="() => Abrir(TipoSolicitud.Retiro, m)">Solicitar retiro</button>
                    <button class="btn chico" type="button" @onclick="() => Abrir(TipoSolicitud.Mantenimiento, m)">Solicitar mantenimiento</button>
                </div>
            </div>
        }
    </div>
}

<div class="botones">
    <button class="btn cian" type="button" @onclick="() => Abrir(TipoSolicitud.NuevaMaquina, null)">Solicitar máquina</button>
</div>

<Hoja @bind-Visible="verForm" Titulo="@TituloHoja">
    <EditForm Model="nueva" OnValidSubmit="Enviar">
        @if (maquina is not null)
        {
            <p>Máquina <strong>@maquina.NumeroIdentificacion</strong> · @maquina.Tipo</p>
        }
        <div class="campo">
            <label>@(nueva.TipoSolicitud == TipoSolicitud.NuevaMaquina ? "¿Qué máquina necesitás?" : "Contanos qué pasa")</label>
            <InputTextArea @bind-Value="nueva.Observaciones" />
        </div>
        <div class="botones">
            <button class="btn" type="submit">Enviar solicitud</button>
            <button class="btn sec" type="button" @onclick="() => verForm = false">Cancelar</button>
        </div>
    </EditForm>
</Hoja>

@code {
    List<MaquinaDto>? maquinas;
    string? error, ok;
    bool verForm;
    MaquinaDto? maquina;
    SolicitudCrearDto nueva = new();

    string TituloHoja => nueva.TipoSolicitud switch
    {
        TipoSolicitud.Retiro => "Solicitar retiro",
        TipoSolicitud.Mantenimiento => "Solicitar mantenimiento",
        _ => "Solicitar máquina nueva"
    };

    protected override async Task OnInitializedAsync()
    {
        try { maquinas = await Api.MisMaquinasAsync(); }
        catch (ApiException ex) { error = ex.Message; maquinas = new(); }
    }

    void Abrir(TipoSolicitud tipo, MaquinaDto? m)
    {
        maquina = m;
        nueva = new SolicitudCrearDto { TipoSolicitud = tipo, IdMaquina = m?.IdMaquina };
        verForm = true;
    }

    async Task Enviar()
    {
        try
        {
            await Api.CrearSolicitudAsync(nueva);
            verForm = false;
            ok = "Solicitud enviada. La podés seguir en Solicitudes.";
        }
        catch (ApiException ex) { verForm = false; error = ex.Message; }
    }
}
