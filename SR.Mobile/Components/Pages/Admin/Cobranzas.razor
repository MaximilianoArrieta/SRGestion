@page "/admin/cobranzas"
@attribute [Authorize(Roles = Roles.Admin)]
@inject SrApi Api
@inject Archivos Archivos

<a class="volver" href="admin/operaciones">‹ Operaciones</a>
<div class="titulo">
    <h1>Cobranzas</h1>
    <p>Lo recaudado en cada máquina.</p>
</div>

<Alerta @bind-Mensaje="error" />
<Alerta @bind-Mensaje="ok" Ok="true" />

<div class="campo">
    <label>Filtrar por cliente</label>
    <select @bind="idCliente" @bind:after="Cargar">
        <option value="0">Todos los clientes</option>
        @foreach (var c in clientes)
        {
            <option value="@c.IdCliente">@c.RazonSocial</option>
        }
    </select>
</div>
<div class="dos">
    <div class="campo"><label>Desde</label><input type="date" @bind="desde" @bind:after="Cargar" /></div>
    <div class="campo"><label>Hasta</label><input type="date" @bind="hasta" @bind:after="Cargar" /></div>
</div>

@if (lista is null)
{
    <Cargando />
}
else
{
    <div class="total">
        <span>@lista.Count cobros</span>
        <span class="monto">@Textos.Plata(lista.Sum(c => c.MontoRecaudado))</span>
    </div>
    @if (lista.Count == 0)
    {
        <div class="vacio">No hay cobranzas para esos filtros.</div>
    }
    <div class="lista">
        @foreach (var c in lista)
        {
            <div class="item naranja">
                <div class="cab">
                    <strong>@c.Maquina</strong>
                    <span class="monto">@Textos.Plata(c.MontoRecaudado)</span>
                </div>
                <div class="linea">@c.Cliente · @Textos.Fecha(c.FechaCobro)</div>
                <div class="linea">Comercio: @Textos.Plata(c.MontoComercio) · SR: @Textos.Plata(c.MontoEmpresa)</div>
            </div>
        }
    </div>
    <div class="botones">
        <button class="btn sec" type="button" @onclick="ExportarPdf">Exportar PDF</button>
    </div>
}

<button class="fab" type="button" @onclick="AbrirRegistrar" aria-label="Registrar cobro">+</button>

<Hoja @bind-Visible="verRegistrar" Titulo="Registrar cobro">
    <EditForm Model="nuevo" OnValidSubmit="Registrar">
        <DataAnnotationsValidator />
        <div class="campo">
            <label>Máquina</label>
            <InputSelect @bind-Value="nuevo.IdMaquina">
                <option value="0">Elegí la máquina</option>
                @foreach (var m in instaladas)
                {
                    <option value="@m.IdMaquina">@m.NumeroIdentificacion · @m.ClienteActual</option>
                }
            </InputSelect>
            <ValidationMessage For="() => nuevo.IdMaquina" />
        </div>
        <div class="campo">
            <label>Fecha</label>
            <InputDate @bind-Value="nuevo.FechaCobro" />
        </div>
        <div class="dos">
            <div class="campo">
                <label>Recaudado ($)</label>
                <InputNumber @bind-Value="nuevo.MontoRecaudado" @bind-Value:after="Calcular" inputmode="decimal" />
            </div>
            <div class="campo">
                <label>% comercio</label>
                <input type="number" inputmode="numeric" @bind="porcentaje" @bind:after="Calcular" />
            </div>
        </div>
        <div class="campo">
            <label>Pagado al comercio ($)</label>
            <InputNumber @bind-Value="nuevo.MontoComercio" inputmode="decimal" />
            <ValidationMessage For="() => nuevo.MontoComercio" />
        </div>
        <div class="campo">
            <label>Observaciones</label>
            <InputTextArea @bind-Value="nuevo.Observaciones" />
        </div>
        <div class="botones">
            <button class="btn" type="submit">Registrar</button>
            <button class="btn sec" type="button" @onclick="() => verRegistrar = false">Cancelar</button>
        </div>
    </EditForm>
</Hoja>

@code {
    List<CobranzaDto>? lista;
    List<ClienteDto> clientes = new();
    List<MaquinaDto> instaladas = new();
    DateTime? desde = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    DateTime? hasta;
    int idCliente, porcentaje = 40;
    bool verRegistrar;
    string? error, ok;
    CobranzaCrearDto nuevo = new();

    protected override async Task OnInitializedAsync()
    {
        try { clientes = await Api.ClientesAsync(incluirBajas: true); } catch (ApiException ex) { error = ex.Message; }
        await Cargar();
    }

    async Task Cargar()
    {
        try { lista = await Api.CobranzasAsync(desde, hasta, idCliente == 0 ? null : idCliente); }
        catch (ApiException ex) { error = ex.Message; lista = new(); }
    }

    async Task AbrirRegistrar()
    {
        try
        {
            instaladas = await Api.MaquinasAsync(estado: EstadoMaquina.Instalada);
            nuevo = new CobranzaCrearDto();
            verRegistrar = true;
        }
        catch (ApiException ex) { error = ex.Message; }
    }

    void Calcular() => nuevo.MontoComercio = Math.Round(nuevo.MontoRecaudado * porcentaje / 100m, 0);

    async Task Registrar()
    {
        try
        {
            var c = await Api.RegistrarCobranzaAsync(nuevo);
            verRegistrar = false;
            ok = $"Cobro de {Textos.Plata(c.MontoRecaudado)} registrado.";
            await Cargar();
        }
        catch (ApiException ex) { verRegistrar = false; error = ex.Message; }
    }

    async Task ExportarPdf()
    {
        try
        {
            var pdf = await Api.ReportePdfAsync("cobranzas", desde, hasta);
            await Archivos.AbrirPdfAsync($"cobranzas-{DateTime.Now:yyyyMMdd}.pdf", pdf);
        }
        catch (ApiException ex) { error = ex.Message; }
    }
}
