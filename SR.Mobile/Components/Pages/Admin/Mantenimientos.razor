@page "/admin/mantenimientos"
@attribute [Authorize(Roles = Roles.Admin)]
@inject SrApi Api

<a class="volver" href="admin/operaciones">‹ Operaciones</a>
<div class="titulo">
    <h1>Mantenimientos</h1>
    <p>Reparaciones y mantenimientos preventivos.</p>
</div>

<Alerta @bind-Mensaje="error" />
<Alerta @bind-Mensaje="ok" Ok="true" />

<div class="pestanas">
    <button class="@(estado is null ? "activa" : "")" @onclick="() => Filtrar(null)">Todos</button>
    @foreach (var e in Enum.GetValues<EstadoMantenimiento>())
    {
        var valor = e;
        <button class="@(estado == valor ? "activa" : "")" @onclick="() => Filtrar(valor)">@Textos.De(valor)</button>
    }
</div>

@if (lista is null)
{
    <Cargando />
}
else if (lista.Count == 0)
{
    <div class="vacio">No hay mantenimientos.</div>
}
else
{
    <div class="lista">
        @foreach (var m in lista)
        {
            <div class="item @Chip.De(m.Estado)" @onclick="() => AbrirEditar(m)" style="cursor:pointer">
                <div class="cab">
                    <strong>@m.Maquina · @m.Tipo</strong>
                    <Chip Texto="@Textos.De(m.Estado)" Color="@Chip.De(m.Estado)" />
                </div>
                <div class="linea">@m.Descripcion</div>
                <div class="linea">@Textos.Fecha(m.Fecha) · @Textos.De(m.TipoMantenimiento) · @Textos.Plata(m.Costo)</div>
            </div>
        }
    </div>
}

<button class="fab" type="button" @onclick="AbrirNuevo" aria-label="Nuevo mantenimiento">+</button>

<Hoja @bind-Visible="verForm" Titulo="@(idEditando is null ? "Nuevo mantenimiento" : "Editar mantenimiento")">
    <EditForm Model="modelo" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <div class="campo">
            <label>Máquina</label>
            <InputSelect @bind-Value="modelo.IdMaquina" disabled="@(idEditando is not null)">
                <option value="0">Elegí la máquina</option>
                @foreach (var m in maquinas)
                {
                    <option value="@m.IdMaquina">@m.NumeroIdentificacion · @(m.ClienteActual ?? "Depósito")</option>
                }
            </InputSelect>
            <ValidationMessage For="() => modelo.IdMaquina" />
        </div>
        <div class="dos">
            <div class="campo">
                <label>Fecha</label>
                <InputDate @bind-Value="modelo.Fecha" />
            </div>
            <div class="campo">
                <label>Tipo</label>
                <InputSelect @bind-Value="modelo.TipoMantenimiento">
                    <option value="@TipoMantenimiento.Preventivo">Preventivo</option>
                    <option value="@TipoMantenimiento.Correctivo">Correctivo</option>
                </InputSelect>
            </div>
        </div>
        <div class="dos">
            <div class="campo">
                <label>Estado</label>
                <InputSelect @bind-Value="modelo.Estado">
                    @foreach (var e in Enum.GetValues<EstadoMantenimiento>())
                    {
                        <option value="@e">@Textos.De(e)</option>
                    }
                </InputSelect>
            </div>
            <div class="campo">
                <label>Costo ($)</label>
                <InputNumber @bind-Value="modelo.Costo" inputmode="decimal" />
            </div>
        </div>
        <div class="campo">
            <label>Descripción</label>
            <InputTextArea @bind-Value="modelo.Descripcion" />
            <ValidationMessage For="() => modelo.Descripcion" />
        </div>
        <div class="botones">
            <button class="btn" type="submit">Guardar</button>
            <button class="btn sec" type="button" @onclick="() => verForm = false">Cancelar</button>
        </div>
    </EditForm>
</Hoja>

@code {
    List<MantenimientoDto>? lista;
    List<MaquinaDto> maquinas = new();
    EstadoMantenimiento? estado;
    bool verForm;
    int? idEditando;
    string? error, ok;
    MantenimientoGuardarDto modelo = new();

    protected override Task OnInitializedAsync() => Cargar();

    async Task Cargar()
    {
        try { lista = await Api.MantenimientosAsync(estado); }
        catch (ApiException ex) { error = ex.Message; lista = new(); }
    }

    Task Filtrar(EstadoMantenimiento? e)
    {
        estado = e;
        return Cargar();
    }

    async Task CargarMaquinas()
    {
        if (maquinas.Count == 0)
            maquinas = (await Api.MaquinasAsync()).Where(m => m.Estado != EstadoMaquina.Baja).ToList();
    }

    async Task AbrirNuevo()
    {
        try
        {
            await CargarMaquinas();
            idEditando = null;
            modelo = new MantenimientoGuardarDto();
            verForm = true;
        }
        catch (ApiException ex) { error = ex.Message; }
    }

    async Task AbrirEditar(MantenimientoDto m)
    {
        try
        {
            await CargarMaquinas();
            idEditando = m.IdMantenimiento;
            modelo = new MantenimientoGuardarDto
            {
                IdMaquina = m.IdMaquina, Fecha = m.Fecha, TipoMantenimiento = m.TipoMantenimiento,
                Descripcion = m.Descripcion, Costo = m.Costo, Estado = m.Estado
            };
            verForm = true;
        }
        catch (ApiException ex) { error = ex.Message; }
    }

    async Task Guardar()
    {
        try
        {
            if (idEditando is null) await Api.CrearMantenimientoAsync(modelo);
            else await Api.EditarMantenimientoAsync(idEditando.Value, modelo);
            verForm = false;
            ok = "Mantenimiento guardado.";
            await Cargar();
        }
        catch (ApiException ex) { verForm = false; error = ex.Message; }
    }
}
