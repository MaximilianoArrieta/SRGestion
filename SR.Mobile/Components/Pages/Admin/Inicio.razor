@page "/admin"
@attribute [Authorize(Roles = Roles.Admin)]
@inject SrApi Api

<div class="titulo">
    <h1>Inicio</h1>
    <p>@DateTime.Today.ToString("dddd d 'de' MMMM")</p>
</div>

<Alerta @bind-Mensaje="error" />

@if (r is null)
{
    <Cargando />
}
else
{
    <div class="kpis">
        <a class="kpi" href="admin/maquinas">
            <span class="etiqueta">Máquinas activas</span>
            <span class="valor">@r.MaquinasInstaladas</span>
            <span class="etiqueta">@r.MaquinasDisponibles en depósito</span>
        </a>
        <a class="kpi" href="admin/cobranzas">
            <span class="etiqueta">Recaudación del mes</span>
            <span class="valor">@Textos.Plata(r.RecaudacionMes)</span>
            <span class="etiqueta">Anterior: @Textos.Plata(r.RecaudacionMesAnterior)</span>
        </a>
        <a class="kpi" href="admin/solicitudes">
            <span class="etiqueta">Solicitudes</span>
            <span class="valor">@r.SolicitudesPendientes</span>
            <span class="etiqueta">pendientes</span>
        </a>
        <a class="kpi" href="admin/mantenimientos">
            <span class="etiqueta">Mantenimientos</span>
            <span class="valor">@r.MantenimientosPendientes</span>
            <span class="etiqueta">abiertos</span>
        </a>
    </div>

    <h2>Próximos retiros</h2>
    @if (r.ProximosRetiros.Count == 0)
    {
        <div class="vacio">No hay retiros en los próximos 30 días.</div>
    }
    else
    {
        <div class="lista">
            @foreach (var i in r.ProximosRetiros)
            {
                <a class="item @(i.FechaRetiroProgramada < DateTime.Today ? "rojo" : "naranja")" href="admin/maquinas/@i.IdMaquina">
                    <div class="cab">
                        <strong>@i.Maquina</strong>
                        <span>@Textos.Fecha(i.FechaRetiroProgramada)</span>
                    </div>
                    <div class="linea">@i.Cliente · @i.Localidad</div>
                </a>
            }
        </div>
    }

    <h2>Mantenimientos abiertos</h2>
    @if (r.MantenimientosAbiertos.Count == 0)
    {
        <div class="vacio">No hay mantenimientos pendientes.</div>
    }
    else
    {
        <div class="lista">
            @foreach (var m in r.MantenimientosAbiertos)
            {
                <a class="item @Chip.De(m.Estado)" href="admin/mantenimientos">
                    <div class="cab">
                        <strong>@m.Maquina</strong>
                        <Chip Texto="@Textos.De(m.Estado)" Color="@Chip.De(m.Estado)" />
                    </div>
                    <div class="linea">@m.Descripcion</div>
                </a>
            }
        </div>
    }
}

@code {
    ResumenDto? r;
    string? error;

    protected override async Task OnInitializedAsync()
    {
        try { r = await Api.ResumenAsync(); }
        catch (ApiException ex) { error = ex.Message; r = new(); }
    }
}
