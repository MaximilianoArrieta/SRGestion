        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                <SinPermiso />
            </NotAuthorized>
            <Authorizing>
                <Cargando />
            </Authorizing>
        </AuthorizeRouteView>
    </Found>
</Router>
