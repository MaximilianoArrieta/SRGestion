@inject NavigationManager Nav

@if (logueado)
{
    <div class="titulo">
        <h1>Sin permiso</h1>
        <p>Tu usuario no tiene acceso a esta pantalla.</p>
    </div>
    <a class="btn" href="">Ir a mi inicio</a>
}

@code {
    [CascadingParameter] Task<AuthenticationState> AuthState { get; set; } = default!;
    bool logueado;

    protected override async Task OnInitializedAsync()
    {
        logueado = (await AuthState).User.Identity?.IsAuthenticated == true;
        if (!logueado) Nav.NavigateTo("login", replace: true);
    }
}
